{
  "expo": {
    "name": "DreamPattern",
    "slug": "dreampattern",
    "scheme": "dreampattern",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0B1F",
    "ios": {
      "bundleIdentifier": "app.dreampattern",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "DreamPattern uses Face ID to keep your dream journal private.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.dreampattern",
      "adaptiveIcon": {
        "backgroundColor": "#0E0B1F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.USE_BIOMETRIC", "android.permission.RECORD_AUDIO"],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-local-authentication",
        { "faceIDPermission": "DreamPattern uses Face ID to keep your dream journal private." }
      ],
      [
        "expo-notifications",
        { "color": "#8B7CF6" }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "DreamPattern uses the microphone so you can speak your dream instead of typing it.",
          "speechRecognitionPermission": "DreamPattern turns your spoken dream into text, on your device where possible."
        }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "eas": { "projectId": "REPLACE_WITH_EAS_PROJECT_ID" }
    }
  }
}
